GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PRICE_IN_PER_M=0.75
GEMINI_PRICE_OUT_PER_M=3.75
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_ENABLED=true
JEV_ADJUDICATE_THRESHOLD=0.8
# Organizers' GET link WITHOUT group_id (it contains a signature - never commit it)
DATASET_API_URL=
MAX_CONCURRENCY=4
CORS_ORIGINS=*

# Load datasets/<name>.json into an empty DB on startup (dialogs only). Empty value disables it.
SEED_DATASET=DEV
